{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ploca-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-04-03",
  "observability": { "enabled": true },
  // MCP treba javnu adresu (agenti nemaju preglednik); štiti ga token, ne Access.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ploca",
      // Zamijeniti pravim ID-jem nakon: npx wrangler d1 create ploca --jurisdiction eu
      // Lokalno (wrangler dev --local) ID nije bitan.
      "database_id": "62f241b2-5223-4c6e-94cc-4079f48b0c71",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Mediji objava (videi, slajdovi, knjižnica). Isti bucket kao na dashboardu: npx wrangler r2 bucket create ploca-mediji --jurisdiction eu
  "r2_buckets": [{ "binding": "MEDIJI", "bucket_name": "ploca-mediji", "jurisdiction": "eu" }]
  // Secret (ne ide u repozitorij): npx wrangler secret put TOKEN_PEPPER
}
