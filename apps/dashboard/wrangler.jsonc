{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ploca-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-04-03",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker se pokreće samo za /api/*; ostalo je statika (index.html).
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ploca",
      // Isti ID kao u apps/mcp/wrangler.jsonc.
      "database_id": "62f241b2-5223-4c6e-94cc-4079f48b0c71",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Postavke prijave (nisu tajne). Moraju biti ovdje, inače ih deploy briše iz nadzorne ploče.
  //   ACCESS_TEAM_DOMAIN  adresa tima u Zero Trustu
  //   ACCESS_AUD          "Application Audience (AUD) Tag" aplikacije "ploca"
  "vars": {
    "ACCESS_AUD": "8a1ae2e5a92d27e39ff9ad235c4fde1ab5d28a7bbde088de9b8c67d308d1554a",
    "ACCESS_TEAM_DOMAIN": "piccolini.cloudflareaccess.com"
  }
  // Lokalno: apps/dashboard/.dev.vars s DEV_USER=tvoj@email (NIKAD u produkciji).
}
