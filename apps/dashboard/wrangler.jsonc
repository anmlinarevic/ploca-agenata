{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ploca-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-04-03",
  "observability": { "enabled": true },
  // Dostupno samo preko ploca.piccoliniplay.hr (Access). Bez ovoga deploy ponovno uključuje workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker se pokreće samo za /api/*; ostalo je statika (index.html).
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ploca",
      // Isti ID kao u apps/mcp/wrangler.jsonc.
      "database_id": "62f241b2-5223-4c6e-94cc-4079f48b0c71",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Pokretanje agenata: izvršitelj nema javnu adresu, dashboard ga zove preko service bindinga.
  // Secret INTERNI_KLJUC mora biti isti kao na izvršitelju: npx wrangler secret put INTERNI_KLJUC
  "services": [{ "binding": "EXEC", "service": "ploca-izvrsitelj" }],
  // Mediji objava i knjižnica materijala (isti bucket kao na MCP-u, EU): npx wrangler r2 bucket create ploca-mediji --jurisdiction eu
  "r2_buckets": [{ "binding": "MEDIJI", "bucket_name": "ploca-mediji", "jurisdiction": "eu" }],
  // Diktiranje u razgovoru s koordinatorom: Whisper preko Workers AI (/api/diktat). I lokalno zove Cloudflare (sitan trošak).
  "ai": { "binding": "AI", "remote": true },
  // Postavke prijave (nisu tajne). Moraju biti ovdje, inače ih deploy briše iz nadzorne ploče.
  //   ACCESS_TEAM_DOMAIN  adresa tima u Zero Trustu
  //   ACCESS_AUD          "Application Audience (AUD) Tag" aplikacije "ploca"
  //   PARRA_ZAKUPAC       zakupac čije su ponude u Parri
  //   META_ZAKUPAC        zakupac čiji su Instagram i Facebook stranica
  //   GSC_ZAKUPAC         zakupac čija je stranica u Google Search Consoleu
  "vars": {
    "ACCESS_AUD": "8a1ae2e5a92d27e39ff9ad235c4fde1ab5d28a7bbde088de9b8c67d308d1554a",
    "ACCESS_TEAM_DOMAIN": "piccolini.cloudflareaccess.com",
    "PARRA_ZAKUPAC": "piccolini",
    "META_ZAKUPAC": "piccolini",
    "GSC_ZAKUPAC": "piccolini"
  },
  // Parra (ponude i uplate, samo čitanje) svakih 30 minuta. Tajne upisuje vlasnik u svom terminalu:
  //   npx wrangler secret put PARRA_API_KLJUC --config apps/dashboard/wrangler.jsonc
  //   npx wrangler secret put PARRA_SUBJEKT --config apps/dashboard/wrangler.jsonc
  // Instagram i Facebook stranica (samo čitanje) svakih 6 sati:
  //   npx wrangler secret put META_TOKEN --config apps/dashboard/wrangler.jsonc
  //   npx wrangler secret put META_STRANICA --config apps/dashboard/wrangler.jsonc
  // Google Search Console (samo čitanje) jednom dnevno, umjesto jednog kruga Parre (upute: docs/GSC-SPAJANJE.md):
  //   Get-Content kljuc.json -Raw | npx wrangler secret put GSC_KLJUC --config apps/dashboard/wrangler.jsonc
  //   npx wrangler secret put GSC_SVOJSTVO --config apps/dashboard/wrangler.jsonc   (npr. sc-domain:piccoliniplay.hr)
  "triggers": { "crons": ["*/30 * * * *", "15 */6 * * *"] }
  // Lokalno: apps/dashboard/.dev.vars s DEV_USER=tvoj@email (NIKAD u produkciji).
}
